# This contract manages a shielded pool with a 1 to 1 conversion with
# respect to the FA1.2 token contract whose address is stored, updated
# by a list of Sapling transactions.  As a convention, all unshield
# transactions must contain in their `bound_data` field a Michelson
# packed address with the default entrypoint, used as the recipient of the
# unshielded tokens.
# Adapted from Raphaël Cauderlier's draft !7252 (dad20ce2d2f0).
# Deposits are executed before withdrawals, preserving transaction
# order within each group. The token contract must transfer exact amounts;
# a failed internal transfer rolls back the entire call.

storage (pair (sapling_state 8) address);
parameter (list (sapling_transaction 8));
code { # Stack manipulation
       # Accumulate deposits and withdrawals separately, in reverse order.
       NIL operation;
       NIL operation;
       PAIR;
       SWAP;
       # We don't want this contract to own any tez so we reject any
       # non-0 incoming transaction.
       AMOUNT;
       PUSH mutez 0;
       COMPARE;
       EQ;
       IF {} { UNIT; FAILWITH };
       UNPAIR 3;
       # The only entrypoint that we are going to call on the stored
       # FA1.2 contract is %transfer; we typecheck it only once.
       DIP 2
           {
             DUP;
             CONTRACT %transfer (pair address address nat);
             IF_NONE { UNIT; FAILWITH } {}
           };
       ITER {
              # If the transaction is valid, the resulting stack contains the
              # bound_data and balance of the transaction and the updated
              # state. If the rest of the script goes well, this state
              # will be the new state of the smart contract.
              SAPLING_VERIFY_UPDATE;
              # In the case of an invalid transaction, we stop.
              IF_NONE { UNIT; FAILWITH } {};
              UNPAIR 3;
              DUG 2;
              # Convert the balance in nat, keeping the signed balance
              # twice on top of the stack and the balance in nat as
              # the third element.
              DUP;
              DUP;
              ABS; # in case of negative balance i.e. shielding
              DUG 2;
              # We have three cases now: unshielding, shielding and transfers.
              # If the balance is strictly positive (i.e. unshielding), we send
              # funds to the given address.
              # If we can't unpack an address from the bound_data, we stop.
              GT;
              IF {
                   DROP;
                   DIP 2
                       {
                         UNPACK address;
                         IF_NONE { UNIT; FAILWITH } {};
                         # A named entrypoint would be a distinct token-ledger
                         # owner that cannot act as SENDER. Check the canonical
                         # encoding, not the supplied bytes: default addresses
                         # PACK to 28 bytes (22-byte destination + 6-byte framing)
                         # in this protocol; named entrypoints append bytes.
                         DUP; PACK; SIZE; PUSH nat 28; COMPARE; EQ;
                         IF {} { PUSH string "FA_NON_DEFAULT_RECIPIENT"; FAILWITH };
                       };
                   SWAP;
                   # The tokens are transferred to the recipient.
                   DIP {
                         SWAP; SELF_ADDRESS; PAIR 3;
                         SWAP; DUP;
                         PUSH mutez 0;
                         DIG 3;
                         TRANSFER_TOKENS;
                         DUG 2;
                         DIP 2 { SWAP; UNPAIR; DIP { SWAP; CONS }; PAIR }
                       }
                 }
                 # If the balance is negative or 0 (i.e. shielding or
                 # transfer), we don't expect any data in
                 # the `bound_data` field.  If one is given, we fail
                 # as it might be an invalid operation or an erroneous
                 # call.
                 {
                   DIP 3
                       {
                         SIZE;
                         PUSH nat 0;
                         COMPARE;
                         EQ;
                         IF {} { UNIT; FAILWITH }
                       };
                   # If the balance is negative (shielding), we also
                   # call the FA1.2 contract to transfer but in the
                   # other direction: from the sender to this contract.
                   LT;
                   IF
                     {
                       SWAP;
                       DIP {
                             SELF_ADDRESS; SENDER; PAIR 3;
                             SWAP; DUP;
                             PUSH mutez 0;
                             DIG 3;
                             TRANSFER_TOKENS;
                             DUG 2;
                             DIP 2 { SWAP; UNPAIR; DIG 2; CONS; PAIR }
                           };
                     }
                     # If the balance is null, there isn't much left
                     # to do.
                     {
                       DROP
                     }
                 }
            };
       SWAP;
       DROP;
       DIG 2;
       # Reverse withdrawals, then prepend deposits in transaction order.
       UNPAIR;
       DIP { NIL operation; SWAP; ITER { CONS } };
       ITER { CONS };
       PAIR 3
     }
